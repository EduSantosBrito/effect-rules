{
  "name": "effect-rules",
  "version": "0.1.0",
  "description": "Custom oxlint rules for Effect TypeScript projects.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsc --outDir dist --declaration",
    "check": "bun --bun tsc --noEmit && bun run lint",
    "format": "bun --bun oxfmt --write package.json tsconfig.json .oxlintrc.json README.md src",
    "format:check": "bun --bun oxfmt --check package.json tsconfig.json .oxlintrc.json README.md src",
    "lint": "bun --bun oxlint -c .oxlintrc.json .",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.63.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
