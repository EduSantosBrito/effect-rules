{
  "name": "effect-rules",
  "version": "0.2.0",
  "description": "Custom oxlint rules for Effect TypeScript projects.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsc --outDir dist --declaration",
    "check": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.test.json && bun run lint",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint -c .oxlintrc.json .",
    "test": "bun --bun vitest run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.63.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.65",
    "@types/bun": "latest",
    "effect": "4.0.0-beta.65",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.4"
  }
}
