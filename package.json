{
  "name": "effect-rules",
  "version": "0.3.2",
  "description": "Custom oxlint rules for Effect TypeScript projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduSantosBrito/effect-rules.git"
  },
  "files": [
    "configs",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configs": {
      "types": "./dist/configs.d.ts",
      "import": "./dist/configs.js"
    }
  },
  "scripts": {
    "build": "bun run clean && bun --bun tsc --outDir dist --declaration",
    "clean": "rm -rf dist",
    "check": "bun run build && bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.test.json && bun run lint && bun run knip",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "knip": "knip",
    "lint": "bun --bun oxlint -c .oxlintrc.json .",
    "test": "bun --bun vitest run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.63.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.65",
    "@types/bun": "latest",
    "effect": "4.0.0-beta.65",
    "knip": "^6.12.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.4"
  }
}
